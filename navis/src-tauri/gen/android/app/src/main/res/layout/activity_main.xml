<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090d16">

    <!-- Native MapLibre OpenGL Viewport -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomFooter"
        android:layout_below="@id/topHeader" />

    <!-- Top Header Navigation Bar -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:background="#f50f172a"
        android:padding="10dp"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etCoords"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#020617"
            android:hint="Search Lat, Lng..."
            android:textColorHint="#64748b"
            android:textColor="#ffffff"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="GO"
            android:textColor="#ffffff"
            android:backgroundTint="#0284c7" />

        <Button
            android:id="@+id/btnLoadTrip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="📂"
            android:textSize="18sp"
            android:backgroundTint="#1e293b" />
    </LinearLayout>

    <!-- Bottom Footer Navigation Banner -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#f00f172a"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#2638bdf8"
                android:text="⬆"
                android:textColor="#38bdf8"
                android:textSize="22sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNavTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Navis Standby"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNavSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Load a trip file or search coordinates"
                    android:textColor="#94a3b8"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>